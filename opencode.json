{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".agents/rules/tech-stack.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-ca4733d1-1997-4a1b-8f3f-b32e7bbff514"
      },
      "enabled": true,
      "oauth": false
    },
    "heroui": {
      "type": "local",
      "command": ["npx", "-y", "@heroui/react-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    }
  }
}
